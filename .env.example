# Copy to `.env.local` for local development, and set the same two variables in
# Vercel → Project → Settings → Environment Variables.
#
# Both are safe to expose in a browser bundle: the anon key is constrained by
# row-level security, which on this project grants SELECT and nothing else.
# Never put the service-role key here — it bypasses RLS.

VITE_SUPABASE_URL=https://vbkausjuwdpdglbirogt.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional. Enables the data.gov.in provider for departmental series.
# Get one free at https://data.gov.in/user/register — without it those series
# fall back to their committed snapshot, which is the correct behaviour.
# VITE_DATA_GOV_IN_KEY=

# Optional. Only needed when serving from a sub-path such as GitHub Pages.
# Vercel serves from the domain root, so leave this unset there.
# SITE_BASE=/
